---
import Base from '../layouts/Base.astro';
import { profile, publications, experience, bibtex } from '../data/site';
---
<Base>
  <section id="about" class="intro">
    <h1>Yanjun Li</h1>
    <p>I am an undergraduate student in Robotics Engineering at <a href="https://english.hust.edu.cn/">Huazhong University of Science and Technology</a>. I am also a research assistant at the EGI Lab, <a href="https://www.pku.edu.cn/">Peking University</a>, advised by Prof. Hao Tang, and a research intern at AI² Robotics.</p>
    <p>My research focuses on world action models, generative robot policies, and 3D representations. I am interested in how models of physical dynamics can help robots act in unfamiliar environments.</p>
    <p class="profile-links"><a href={'mailto:' + profile.email}>Email</a><span>/</span><a href={profile.scholar}>Google Scholar</a><span>/</span><a href={profile.github}>GitHub</a></p>
  </section>

  <section id="research" class="content-section">
    <div class="section-heading"><h2>Publications</h2><a href={profile.scholar}>Full list on Google Scholar</a></div>
    <div class="publications">
      {publications.map(paper => <article class="publication">
        <a class="paper-image" href={paper.project || 'https://arxiv.org/abs/' + paper.arxiv} aria-label={paper.name + (paper.project ? ' project page' : ' paper')}><img src={paper.image} alt={paper.imageAlt} width="600" height="360" loading="lazy" /></a>
        <div class="paper-content">
          <h3><a href={'https://arxiv.org/abs/' + paper.arxiv}>{paper.title}</a></h3>
          <p class="authors">{paper.authors.map((author,i) => <>{i>0 && ', '}{author === profile.name ? <strong>{author}{paper.equal && i<4 ? '*' : ''}</strong> : <>{author}{paper.equal && i<4 ? '*' : ''}</>}</>)}</p>
          <p class="paper-venue">arXiv preprint, {paper.year}</p>
          <p class="paper-description">{paper.description}</p>
          <div class="paper-links"><a href={'https://arxiv.org/abs/' + paper.arxiv}>Paper</a>{paper.project && <a href={paper.project}>Project</a>}{paper.code && <a href={paper.code}>Code</a>}<details class="citation"><summary>BibTeX</summary><div class="citation-body"><pre><code>{bibtex(paper)}</code></pre><button type="button" class="copy-citation">Copy citation</button><a href={'/bib/' + paper.id + '.bib'} download>Download .bib</a><span class="copy-status" role="status"></span></div></details></div>
        </div>
      </article>)}
    </div>
    <p class="publication-note">* Equal contribution.</p>
  </section>

  <section id="experience" class="content-section">
    <h2>Experience</h2>
    <div class="experience-list">{experience.map(item => <div class="experience-item"><div><h3>{item.organization}</h3><p>{item.role}</p></div><span class="date">{item.date}</span></div>)}</div>
  </section>

  <section class="content-section education">
    <h2>Education</h2>
    <div class="experience-item"><div><h3>Huazhong University of Science and Technology</h3><p>B.E. in Robotics Engineering</p></div><span class="date">2022 – 2026</span></div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-citation').forEach(button => {
    button.addEventListener('click', async () => {
      const body = button.closest('.citation-body');
      const code = body?.querySelector('code')?.textContent;
      const status = body?.querySelector('.copy-status');
      if (!code || !status) return;
      try { await navigator.clipboard.writeText(code); status.textContent = 'Copied!'; }
      catch { status.textContent = 'Select the citation above to copy it.'; }
      window.setTimeout(() => { status.textContent = ''; }, 3500);
    });
  });
</script>
