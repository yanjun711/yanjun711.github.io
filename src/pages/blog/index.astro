---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({data}) => !data.draft && data.date <= new Date())).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="Blogs" description="Research notes by Yanjun Li.">
  <div class="page-heading"><h1>Blogs</h1><p>Research notes and articles.</p></div>
  <div class="blog-list">{posts.length ? <PostList posts={posts} /> : <p class="empty-notebook">No posts yet. <a href="/rss.xml">RSS feed</a></p>}</div>
</Base>
