---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({data}) => !data.draft && data.date <= new Date())).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="Notes & ideas" description="Research notes, experiments, and things learned along the way by Yanjun Li.">
  <div class="page-heading"><a class="back-link" href="/">← Back home</a><p class="eyebrow">THE NOTEBOOK</p><h1>Notes & <em>ideas.</em></h1><p>Research, experiments, and a little thinking out loud.</p></div>
  <div class="blog-list">{posts.length ? <PostList posts={posts} /> : <div class="empty-notebook"><span aria-hidden="true">✳</span><h2>Good things take a little thinking.</h2><p>No posts just yet. In the meantime, take a look at <a href="/#research">my research</a>.</p><a class="text-link" href="/rss.xml">Follow via RSS ↗</a></div>}</div>
</Base>
