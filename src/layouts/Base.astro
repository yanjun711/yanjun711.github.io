---
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import { profile } from '../data/site';
const { title = profile.name, description = profile.description, article = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const onBlog = Astro.url.pathname.startsWith('/blog');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafbf8" />
    <title>{title === profile.name ? `${profile.name} · Robot Learning` : `${title} · ${profile.name}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Yanjun Li — Writing" href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="Yanjun Li — home"><span class="monogram">yl<span>·</span></span><span class="brand-name">Yanjun Li</span></a>
      <nav aria-label="Main navigation">
        <a href="/#about">About</a>
        <a href="/#research">Research</a>
        <a href="/blog/" aria-current={onBlog ? 'page' : undefined}>Writing</a>
        <a href="/#experience">Experience</a>
      </nav>
      <a class="header-contact" href={`mailto:${profile.email}`}>Say hello <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main" class="wrap"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-name" href="/">Yanjun Li</a><span class="footer-note">Learning from the world.</span></div>
      <div class="footer-links"><a href={profile.github}>GitHub ↗</a><a href={profile.scholar}>Scholar ↗</a><a href="/rss.xml">RSS ↗</a><a href={`mailto:${profile.email}`}>Email ↗</a></div>
      <span class="copyright">© {new Date().getFullYear()} Yanjun Li</span>
    </footer>
  </body>
</html>
