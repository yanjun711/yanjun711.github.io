---
import type { publications } from '../data/site';
type Paper = (typeof publications)[number];
const { paper } = Astro.props as { paper: Paper };
const preview = 'preview' in paper ? paper.preview : undefined;
const href = paper.project || 'https://arxiv.org/abs/' + paper.arxiv;
const label = paper.name + (paper.project ? ' project page' : ' paper');
---
{preview ? <div class="paper-preview" data-name={paper.name}>
  <a class="paper-image" href={href} aria-label={label}>
    <video autoplay muted loop playsinline preload="auto" poster={preview.poster} width="640" height="640" aria-label={preview.alt}>
      <source src={preview.src} type="video/mp4" />
      <img src={preview.poster} alt={preview.alt} width="640" height="640" loading="lazy" />
    </video>
  </a>
</div> : <a class="paper-image" href={href} aria-label={label}><img src={paper.image} alt={paper.imageAlt} width="600" height="360" loading="lazy" /></a>}

<script>
  document.querySelectorAll<HTMLVideoElement>('.paper-preview video').forEach(video => {
    video.muted = true;
    void video.play().catch(() => {});
  });
</script>
