---
import type { CollectionEntry } from 'astro:content';
import { profile } from '../data/site';
const { posts } = Astro.props as { posts: CollectionEntry<'blog'>[] };
---
<ol class="post-list" reversed>
  {posts.map(post => <li>
    <a class="post-row" href={`/blog/${post.id}/`}>
      <div class="post-info"><h2>{post.data.title}</h2><p>{profile.name}</p></div>
      <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
    </a>
  </li>)}
</ol>
